{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-05",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "ovihomma",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
	},
	"observability": {
		"enabled": true,
	},
	"vars": {
	  "CONTACT_TO_EMAIL": "info@bestpartners.fi",
		"CONTACT_FROM_EMAIL": "J&P Best Partners SL <info@bestpartners.fi>"
	},
	"kv_namespaces": [
		{
			"binding": "CONTACT_RATE_LIMIT",
			"id": "7a1cafca943a4e3291eb3a55d4b3ce12"
		}
	],
}
