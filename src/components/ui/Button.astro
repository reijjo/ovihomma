---
import type { HTMLAttributes } from "astro/types";
import "./Button.css";

type Props = HTMLAttributes<"button"> & {
  variant?: "cta" | "outline";
};

const {
  class: className,
  variant = "cta",
  type = "button",
  ...rest
} = Astro.props;
---

<button
  class:list={[
    "btn",
    { "btn-cta": variant === "cta", "btn-outline": variant === "outline" },
    className,
  ]}
  {...rest}
>
  <slot />
</button>
