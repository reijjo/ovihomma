---
import { t } from "@/i18n";
import Linkbutton from "@/components/ui/Linkbutton.astro";

const i18n = t(Astro.currentLocale);

type Props = {
  title: string
}

const { title } = Astro.props
---

<section class="cta-component-section">
  <h4>{title}</h4>
  <Linkbutton href="/yhteystiedot"
    >{i18n.homepage.ctaComp.buttonText}</Linkbutton
  >
</section>

<style>
  .cta-component-section {
    padding: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    text-wrap: balance;
    background-color: var(--black-base);

    & h4 {
      font-size: 2rem;
      color: white;
    }

    & button {
      height: 3rem;
    }
  }
</style>
