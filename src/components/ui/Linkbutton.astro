---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { HTMLAttributes } from "astro/types";
import "./Button.css";

type Props = HTMLAttributes<"a"> & {
  variant?: "cta" | "outline";
  href: string;
};

const {
  class: className,
  variant = "cta",
  href,
  ...rest
} = Astro.props;

const currentLocale = Astro.currentLocale ?? "fi";

function localizedHref(inputHref: string) {
  if (/^(https?:|mailto:|tel:|#|\/\/)/.test(inputHref)) return inputHref;

  if (inputHref.startsWith("/")) {
    const route = inputHref.replace(/^\/+/, "").replace(/\/$/, "");
    return route
      ? getRelativeLocaleUrl(currentLocale, route)
      : getRelativeLocaleUrl(currentLocale);
  }

  return inputHref;
}
---

<a
  href={localizedHref(href)}
  class:list={[
    "btn",
    { "btn-cta": variant === "cta", "btn-outline": variant === "outline" },
    className,
  ]}
  {...rest}
>
  <slot />
</a>

<style>
  .btn {
    border: 1px solid transparent;
    border-radius: 8px;
    border-radius: 100px;
    padding: 0.75rem 1.5rem;
    padding: 1rem 2rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.08em;
    width: max-content;
  }

  .btn-cta {
    border-color: transparent;
    background-color: var(--accent-base);
    color: white;
    transition: all 0.25s ease;
    box-shadow:
      inset 1px 1px 4px var(--accent-light),
      inset -1px -1px 4px var(--accent-dark);

    &:hover {
      background-color: var(--accent-dark);
      box-shadow:
        inset 1px 1px 4px var(--accent-base),
        inset -1px -1px 4px var(--accent-xdark),
        0 4px 16px rgb(0 0 0 / 15%),
        0 8px 32px rgb(0 0 0 / 10%);
    }

    &:active {
      background-color: var(--accent-dark);
      box-shadow:
        inset 1px 1px 4px var(--accent-xdark),
        inset -1px -1px 4px var(--accent-xdark);
    }
  }
</style>
