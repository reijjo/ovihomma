---
import { getRelativeLocaleUrl } from "astro:i18n";

import MobileNav from "./MobileNav.astro";

const currentLocale = Astro.currentLocale ?? "fi";

function localizedHref(locale: string, key?: string) {
  return key ? getRelativeLocaleUrl(locale, key) : getRelativeLocaleUrl(locale);
}
---

<nav class="site-nav">
  <div class="wrapper nav-content">
    <MobileNav localizedHref={localizedHref} currentLocale={currentLocale} />
  </div>
</nav>

<!-- Script  -->
<script>
  function normalizePath(path: string) {
    if (path === "/") return "/";
    return path.replace(/\/$/, "");
  }

  function updateActiveNavLink() {
    const currentPath = normalizePath(window.location.pathname);

    document.querySelectorAll(".nav-link a").forEach((link) => {
      const href = link.getAttribute("data-href");
      if (!href) return;

      const normalizedHref = normalizePath(href);
      link.classList.toggle(
        "active",
        normalizedHref === currentPath ||
          (normalizedHref !== "/" && currentPath.startsWith(`${normalizedHref}/`)),
      );
    });
  }

  updateActiveNavLink();

  const win = window as Window & { __navActiveListenerBound?: boolean };

  if (!win.__navActiveListenerBound) {
    document.addEventListener("astro:page-load", updateActiveNavLink);
    win.__navActiveListenerBound = true;
  }
</script>

<!-- Styles -->
<style>
  nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    min-height: var(--nav-height);
    border-bottom: 1px solid rgba(50, 50, 50, 0.12);
    box-shadow: var(--shadow-xs);
    background-color: var(--white-xlight);
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--nav-height);
    width: 100%;
    margin: 0 auto;
    font-family: var(--font-heading);
    text-transform: uppercase;
  }

  .nav-logo {
    flex: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .nav-content {
    gap: 0.75rem;
    padding-block: 0.5rem;
  }
</style>
