---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import NavLinksList from "./NavLinksList.astro";
import { t } from "@/i18n";

type Props = {
  localizedHref: (locale: string, key?: string) => string;
  currentLocale: string;
};

const { localizedHref, currentLocale } = Astro.props;
const dict = t(currentLocale);
---

<div class="desktop-nav">
  <a href={localizedHref(currentLocale)} class="nav-logo">{dict.yleiset.firmanNimi}</a>
  <NavLinksList localizedHref={localizedHref} currentLocale={currentLocale} />
  <LanguageSwitcher />
</div>

<style>
  .desktop-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;

    @media (max-width: 800px) {
      display: none;
    }
  }
</style>
