---
import { t } from "@/i18n";
import { ChevronDown } from "@lucide/astro";

type Props = {
  localizedHref: (locale: string, key?: string) => string;
  currentLocale: string;
};

const { localizedHref, currentLocale } = Astro.props;
const dict = t(currentLocale);

const navLinks = [
  { key: "", label: dict.nav.home },
];

const secondaryNavLinks = [
  { key: "huolto", label: dict.nav.huolto },
  { key: "meista", label: dict.nav.meistä },
  { key: "yhteystiedot", label: dict.nav.yhteystiedot },
];

const productLinks = [
  { key: "nosto-ovet", label: dict.nav.products.nostoOvet },
  {
    key: "rullaovet-turvakaihtimet",
    label: dict.nav.products.rullaovetTurvakaihtimet,
  },
  { key: "palo-ovet", label: dict.nav.products.paloOvet },
  { key: "puomit", label: dict.nav.products.puomit },
  { key: "hyllyt", label: dict.nav.products.hyllyt },
];
---

<ul class="nav-links-list">
  {
    navLinks.map((link) => (
      <li class="nav-link">
        <a
          href={localizedHref(currentLocale, link.key)}
          data-href={localizedHref(currentLocale, link.key)}
        >
          {link.label}
        </a>
      </li>
    ))
  }
  <li class="nav-link products-nav-link">
    <details class="products-dropdown">
      <summary
        class="products-trigger"
      >
        {dict.nav.tuotteet}
        <ChevronDown
          class="products-caret"
          size={16}
          stroke-width={2}
          aria-hidden="true"
        />
      </summary>
      <ul class="products-menu">
        {
          productLinks.map((link) => (
            <li class="products-menu-item">
              <a
                href={localizedHref(currentLocale, `tuotteet/${link.key}`)}
                data-href={localizedHref(currentLocale, `tuotteet/${link.key}`)}
                data-astro-prefetch="false"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </li>
  {
    secondaryNavLinks.map((link) => (
      <li class="nav-link">
        <a
          href={localizedHref(currentLocale, link.key)}
          data-href={localizedHref(currentLocale, link.key)}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links-list {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 1.5vw, 1.5rem);
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .nav-link a {
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  .nav-link a:hover,
  .nav-link a:focus-visible {
    color: var(--accent-base);
  }

  .nav-link a.active,
  .products-trigger.active {
    opacity: 1;
    font-weight: 600;
  }

  .nav-link a.active:hover {
    color: inherit;
  }

  .products-nav-link {
    position: relative;
  }

  .products-dropdown {
    position: relative;
  }

  .products-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    cursor: pointer;
    list-style: none;
    transition: color 160ms ease;
  }

  .products-trigger::-webkit-details-marker {
    display: none;
  }

  .products-trigger:hover,
  .products-trigger:focus-visible {
    color: var(--accent-base);
  }

  .products-caret {
    flex: none;
    transition: transform 160ms ease;
  }

  .products-dropdown[open] .products-caret {
    transform: rotate(180deg);
  }

  .products-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    z-index: 2;
    display: none;
    min-width: 14rem;
    padding: 0.5rem;
    margin: 0;
    list-style: none;
    background: var(--white-xlight);
    border: 1px solid var(--border-xxlight);
    box-shadow: var(--shadow-xs);
    transform: translateX(-50%);
    border-radius: 8px;
  }

  .products-dropdown:hover .products-menu,
  .products-dropdown:focus-within .products-menu,
  .products-dropdown[open] .products-menu {
    display: block;
  }

  .products-menu-item a {
    display: block;
    padding: 0.55rem 0.75rem;
    white-space: nowrap;
  }

  @media (width <= 800px) {
    .nav-links-list {
      flex-direction: column;
      align-items: stretch;
      width: min(100%, 20rem);
    }

    .nav-link,
    .products-nav-link,
    .products-dropdown {
      width: 100%;
    }

    .nav-link > a,
    .products-trigger {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      width: 100%;
      padding-inline: 0.5rem;
    }

    .products-menu {
      position: static;
      min-width: 0;
      width: 100%;
      padding: 0.25rem 0 0.25rem 1.25rem;
      border: 0;
      box-shadow: none;
      transform: none;
      text-align: left;
    }

    .products-menu-item a {
      padding: 0.4rem 0.5rem;
      font-size: 0.9rem;
      line-height: 1.3;
      white-space: normal;
      text-wrap: balance;
    }
  }
</style>

<script>
  function updateProductNavActiveLink() {
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    document.querySelectorAll(".nav-link a, .products-trigger").forEach((link) => {
      const href = link.getAttribute("data-href");
      if (!href) return;

      const normalizedHref = href.replace(/\/$/, "") || "/";
      const isProductsRoute = normalizedHref.endsWith("/tuotteet");
      link.classList.toggle(
        "active",
        normalizedHref === currentPath ||
          (isProductsRoute && currentPath.startsWith(`${normalizedHref}/`)),
      );
    });
  }

  updateProductNavActiveLink();

  const win = window as Window & {
    __productNavActiveListenerBound?: boolean;
  };
  if (!win.__productNavActiveListenerBound) {
    document.addEventListener("astro:page-load", updateProductNavActiveLink);
    win.__productNavActiveListenerBound = true;
  }
</script>
