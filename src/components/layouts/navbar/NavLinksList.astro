---
import { getNavLinks } from "./navLinks";

type Props = {
  localizedHref: (locale: string, key?: string) => string;
  currentLocale: string;
};

const { localizedHref, currentLocale } = Astro.props;
const navLinks = getNavLinks(currentLocale);
---

<ul class="nav-links-list">
  {
    navLinks.map((link) => (
      <li class="nav-link">
        <a
          href={localizedHref(currentLocale, link.key)}
          data-href={localizedHref(currentLocale, link.key)}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .nav-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 1.5vw, 1.5rem);
    padding: 0;
    margin: 0;
    width: min(100%, 20rem);
  }

  .nav-link a {
    transition:
      color 160ms ease,
      opacity 160ms ease;
  }

  .nav-link a:hover,
  .nav-link a:focus-visible {
    color: var(--accent-base);
  }

  .nav-link a.active {
    opacity: 1;
    font-weight: 600;
  }

  .nav-link a.active:hover {
    color: inherit;
  }

  .nav-link,
  .nav-link > a {
    width: 100%;
  }

  .nav-link > a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-inline: 0.5rem;
  }
</style>

<script>
  function updateNavActiveLinks() {
    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    document.querySelectorAll(".nav-link a").forEach((link) => {
      const href = link.getAttribute("data-href");
      if (!href) return;

      const normalizedHref = href.replace(/\/$/, "") || "/";
      link.classList.toggle(
        "active",
        normalizedHref === currentPath ||
          (normalizedHref !== "/" && currentPath.startsWith(`${normalizedHref}/`)),
      );
    });
  }

  updateNavActiveLinks();

  const win = window as Window & {
    __navLinksActiveListenerBound?: boolean;
  };
  if (!win.__navLinksActiveListenerBound) {
    document.addEventListener("astro:page-load", updateNavActiveLinks);
    win.__navLinksActiveListenerBound = true;
  }
</script>
