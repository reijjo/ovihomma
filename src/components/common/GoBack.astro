---
interface Props {
  text: string;
  href: string;
}

import { ArrowLeft } from '@lucide/astro';

const { text, href } = Astro.props;
---
<div class="go-back wrapper">
  <ArrowLeft size={16} />
  <a href={href}>{text}</a>
</div>

<style>
  .go-back {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-xdark);

    &:hover {
      color: var(--accent-base);
    }
  }
</style>
