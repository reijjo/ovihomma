---
import TuoteIntro from "../TuoteIntro.astro"
import { t } from "@/i18n"
import CtaComponent from "@/components/ui/CtaComponent.astro"

const i18n = t(Astro.currentLocale)
const rullaOvet = i18n.tuotteet.paloOvet.rullaovet
---

<main class="tuote-page">
  <TuoteIntro title={rullaOvet.title} intro={rullaOvet.intro} />
  <CtaComponent title={rullaOvet.sell} />
</main>

<style>
  .tuote-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
