---
import Tuotekuvia from "@/components/pages/tuotteet/TuoteKuvat.astro";
import TuoteValikoima from "@/components/pages/tuotteet/TuoteValikoima.astro";
import { t } from "@/i18n";

const i18n = t(Astro.currentLocale);
const paloOvet = i18n.tuotteet.paloOvet;
---

<main class="tuote-page">
  <div class="wrapper tuote-intro">
    <h1>{paloOvet.title}</h1>
    <p>{paloOvet.info.intro}</p>
  </div>
  <TuoteValikoima
    title={paloOvet.info.valikoima}
    items={[
      { label: paloOvet.info.valikoimaItems.metalli, href: "/tuotteet/palo-ovet/metalliovet" },
      { label: paloOvet.info.valikoimaItems.rulla, href: "/tuotteet/palo-ovet/rullaovet" },
      { label: paloOvet.info.valikoimaItems.liukuovet, href: "/tuotteet/palo-ovet/liukuovet" },
      { label: paloOvet.info.valikoimaItems.kaihtimet, href: "/tuotteet/palo-ovet/kaihtimet" },
    ]}
  />

  <div class="wrapper tuote-moreInfo">
    <p set:html={paloOvet.info.moreInfo} />
    <p set:html={paloOvet.info.moreInfo2} />
  </div>
  <div class="tuote-highlight">
    <div class="wrapper tuote-sertifikaatit">
      <h2>{paloOvet.sertifikaatit.title}</h2>
      <ul class="tuote-lista">
        <li set:html={paloOvet.sertifikaatit.items.metalli} />
        <li set:html={paloOvet.sertifikaatit.items.rulla} />
        <li set:html={paloOvet.sertifikaatit.items.liukuovet} />
        <li set:html={paloOvet.sertifikaatit.items.kaihtimet} />
      </ul>
      <p set:html={paloOvet.sertifikaatit.info} />
    </div>
  </div>
  <Tuotekuvia images={[
    { src: "/images/ovet/palo-ovet/paloliuku1.webp", alt: "fire sliding door 1" },
    { src: "/images/ovet/palo-ovet/paloliuku2.webp", alt: "fire sliding door 2" },
    { src: "/images/ovet/palo-ovet/paloliuku3.webp", alt: "fire sliding door 3" },
    { src: "/images/ovet/palo-ovet/paloliuku4.webp", alt: "fire sliding door 4" },
    { src: "/images/ovet/palo-ovet/palorulla1.webp", alt: "fire roller door 1" },
    { src: "/images/ovet/palo-ovet/palorulla2.webp", alt: "fire roller door 2" },
    { src: "/images/ovet/palo-ovet/palometalli2.webp", alt: "fire metal door 2" },
    { src: "/images/ovet/palo-ovet/palometalli3.webp", alt: "fire metal door 3" },
    { src: "/images/ovet/palo-ovet/palometalli1.webp", alt: "fire metal door 1" },
  ]} />
</main>

<style>
  .tuote-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tuote-intro, .tuote-moreInfo, .tuote-sertifikaatit, .tuote-kuvia {
    gap: 0.5rem;
    display: flex;
    flex-direction: column;
    width: min(100%, 800px);
    text-wrap: pretty;
  }

  .tuote-sub-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    place-items: center;
    gap: 1rem;
  }

  .tuote-sub {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    & img {
      max-width: 250px;
      width: 100%;
      aspect-ratio: 4/3;
      justify-content: center;
    }
  }

  .tuote-detail summary {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--accent-xdark);
  }

  .tuote-sertifikaatit h2 {
    text-transform: uppercase;
  }

  .tuote-lista {
    list-style-position: inside;

    & li {
      padding-left: 1rem;
    }
  }

  .tuote-highlight {
    background-color: var(--accent-xxlight);
    padding-block: 1rem;
  }
</style>
