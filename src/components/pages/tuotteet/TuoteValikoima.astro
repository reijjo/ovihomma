---
import { getRelativeLocaleUrl } from "astro:i18n";

type Item = {
  label: string;
  href: string;
  img: string;
};

type Props = {
  title: string;
  items: Item[];
  extraClass?: string;
};

const { title, items, extraClass } = Astro.props;
const currentLocale = Astro.currentLocale ?? "fi";

function localizedHref(href: string) {
  if (/^(https?:|mailto:|tel:|#|\/\/)/.test(href)) return href;

  const route = href.replace(/^\/+/, "").replace(/\/$/, "");
  return route
    ? getRelativeLocaleUrl(currentLocale, route)
    : getRelativeLocaleUrl(currentLocale);
}
---

<div class="wrapper tuote-valikoima">
  <p class="text-center"><b>{title}</b></p>
  <div class="tuote-list">
    {items.map((item) => (
      <a class={`tuote-list-link ${extraClass}`} href={localizedHref(item.href)}>
        <img class="tuote-list-img" src={item.img} alt={item.label} />
        <p class="tuote-list-label">{item.label}</p>
      </a>
    ))}
  </div>
</div>

<style>
.tuote-valikoima {
  display: flex;
  flex-direction: column;
  width: min(100%, 800px);
  text-wrap: pretty;
  gap: 1rem;
}

.tuote-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1rem;
  place-items: center;
}

.tuote-list-link {
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  border: 1px solid transparent;

  &:hover {
    border: 1px solid var(--border-xxlight);
    box-shadow: var(--shadow-xs);

    & .tuote-list-label {
      color: var(--accent-xdark);
    }
  }
}

.tuote-list-img {
  width: 100%;
  max-width: 300px;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 4px;
  justify-self: center;
}

.tuote-list-label {
  text-align: center;
  font-weight: 600;
  font-size: 1.125rem;
  padding-block: 0.5rem;
}
</style>
