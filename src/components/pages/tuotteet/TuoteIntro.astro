---
type Props = {
  title: string;
  intro: string
  extraClass?: string;
}

const { title, intro, extraClass } = Astro.props
---

<section class={`wrapper tuote-intro ${extraClass}`}>
  <h1>{title}</h1>
  <p set:html={intro}/>
</section>

<style>
.tuote-intro {
  gap: 0.5rem;
  display: flex;
  flex-direction: column;
  width: min(100%, 800px);
  text-wrap: pretty;
}
</style>
