---
import { t } from "@/i18n"
const i18n = t(Astro.currentLocale)

interface Props {
  images: { src: string; alt: string }[];
}
const { images } = Astro.props;
---

<div class="wrapper tuote-kuvia">
  <h3>{i18n.tuotteet.esimerkkeja}</h3>
  <div class="tuote-gallery">
    {images.map((img) => (
      <img src={img.src} alt={img.alt} loading="lazy" />
    ))}
  </div>
</div>

<style>
  .tuote-kuvia {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;

    & h3 {
      text-align: center;
      text-transform: uppercase;
    }
  }
  .tuote-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    & img {
      width: 100%;
      max-width: 300px;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 4px;
      justify-self: center;
    }
  }
</style>
