---
import { t } from "@/i18n"
import { getRelativeLocaleUrl } from "astro:i18n"
const i18n = t(Astro.currentLocale)
const currentLocale = Astro.currentLocale ?? "fi"

interface Props {
  images: { src: string; alt: string }[];
}
const { images } = Astro.props;
---

<div class="wrapper tuote-kuvia">
  <h3>{i18n.tuotteet.esimerkkeja}</h3>
  <div class="tuote-gallery">
    {images.map((img) => (
      <img src={img.src} alt={img.alt} loading="lazy" />
    ))}
  </div>
  <div class="check-gallery"><p>{i18n.tuotteet.checkGallery}</p> <a href={getRelativeLocaleUrl(currentLocale, "galleria")}>{i18n.tuotteet.galleriasta}</a></div>
</div>

<style>
  .tuote-kuvia {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;

    & h3 {
      text-align: center;
      text-transform: uppercase;
    }
  }
  .tuote-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    & img {
      width: 100%;
      max-width: 300px;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 4px;
      justify-self: center;
    }
  }

  .check-gallery {
    font-size: 1.25rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;

    & a {
      color: var(--accent-xdark);
      text-decoration: underline;

      &:hover {
        color: var(--accent-base);
      }
    }
  }
</style>
