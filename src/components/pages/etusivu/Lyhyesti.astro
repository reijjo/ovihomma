---
import LyhyestiKuva from "./LyhyestiKuva.astro";
import { t } from "@/i18n";
import autotalli from "./kuvat/autotalli.webp";
import rullaovi from "./kuvat/rullaovi.webp";
import paloOvi from "./kuvat/palo-ovi.webp";

const i18n = t(Astro.currentLocale);
---

<section class="lyhyesti wrapper">
  <p class="lyhyesti-text">{i18n.homepage.lyhyesti.aboutUs}</p>
  <div class="lyhyesti-kuvat-container">
    <LyhyestiKuva
      src={autotalli.src}
      alt={i18n.homepage.lyhyesti.kuvat.nostoOvet.header}
      header={i18n.homepage.lyhyesti.kuvat.nostoOvet.header}
      subheader={i18n.homepage.lyhyesti.kuvat.nostoOvet.subHeader}
    />
    <LyhyestiKuva
      src={rullaovi.src}
      alt={i18n.homepage.lyhyesti.kuvat.rullaovet.header}
      header={i18n.homepage.lyhyesti.kuvat.rullaovet.header}
      subheader={i18n.homepage.lyhyesti.kuvat.rullaovet.subHeader}
    />
    <LyhyestiKuva
      src={paloOvi.src}
      alt={i18n.homepage.lyhyesti.kuvat.paloOvet.header}
      header={i18n.homepage.lyhyesti.kuvat.paloOvet.header}
      subheader={i18n.homepage.lyhyesti.kuvat.paloOvet.subHeader}
    />
    <LyhyestiKuva
      src={paloOvi.src}
      alt={i18n.homepage.lyhyesti.kuvat.puomit.header}
      header={i18n.homepage.lyhyesti.kuvat.puomit.header}
      subheader={i18n.homepage.lyhyesti.kuvat.puomit.subHeader}
    />
    <LyhyestiKuva
      src={paloOvi.src}
      alt={i18n.homepage.lyhyesti.kuvat.hyllykot.header}
      header={i18n.homepage.lyhyesti.kuvat.hyllykot.header}
      subheader={i18n.homepage.lyhyesti.kuvat.hyllykot.subHeader}
    />
  </div>
</section>

<!-- Style -->
<style>
  .lyhyesti {
    padding: 2rem;
    gap: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .lyhyesti-text {
    font-size: 1.25rem;
    text-wrap: pretty;
    max-width: 800px;
  }

  .lyhyesti-kuvat-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 350px));
    justify-content: center;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }
</style>
