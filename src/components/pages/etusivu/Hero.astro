---
import Button from "@/components/ui/Button.astro";
import { t } from "@/i18n";

const i18n = t(Astro.currentLocale);
---

<section class="hero-section">
  <div class="hero-content wrapper">
    <h1 class="hero-header">{i18n.homepage.hero.header}</h1>
    <Button class="hero-button">{i18n.homepage.hero.heroCta}</Button>
    <div class="hero-overlay"></div>
  </div>
</section>

<script>
  function resetHomeScroll() {
    if (window.location.pathname !== "/") return;
    window.scrollTo({ top: 0, left: 0, behavior: "auto" });
  }

  resetHomeScroll();
  document.addEventListener("astro:page-load", resetHomeScroll);
</script>

<!-- Styles -->
<style>
  .hero-section {
    display: grid;
    place-items: center;
    height: 80dvh;
    width: 100%;
    background-image: url("/images/etusivu/heroholder.jpg");
    background-position: center;
    background-size: cover;
    position: relative;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    padding-block: 2rem;
  }

  .hero-locale-switcher {
    position: relative;
    z-index: 2;
  }

  .hero-header {
    font-size: 3rem;
    text-align: center;
    text-wrap: balance;
    z-index: 2;
    color: white;
    position: relative;
  }

  .hero-button {
    position: relative;
    z-index: 2;
    height: 3rem;
    transform: scale(1.125);
  }

  .hero-overlay {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgb(0 0 0 / 50%), rgb(0 0 0 / 50%));
    z-index: 1;
    position: absolute;
    top: 0;
    left: 0;
  }
</style>
