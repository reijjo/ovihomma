---
import { t } from "@/i18n"
import TuotteetList from "./TuotteetList.astro";

const i18n = t(Astro.currentLocale);
---

<section class="wrapper about-esittely-wrapper">
  <p class="about-esittely max-800">
    <span>Firmannimi</span> {i18n.aboutUs.yrityksesta.esittely}
  </p>
  <div class="about-valikoima">
    <div class="about-tuotteet">
      <h2 class="smaller-h2">{i18n.aboutUs.yrityksesta.tuotevalikoima.otsikko}</h2>
      <TuotteetList />
    </div>
    <div class="about-kumppanit">
      <h2 class="smaller-h2">{i18n.aboutUs.yrityksesta.kumppanit}</h2>
    </div>
  </div>
</section>

<style>
  .about-esittely-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-wrap: pretty;
  }

  .about-esittely {
    font-size: 1.125rem;
    text-wrap: pretty;


    & span {
      color: var(--accent-dark);
      font-weight: 500;
    }
  }

  .about-valikoima {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    max-width: 800px;
    width: 100%;
    margin: 0 auto;

  }

  .about-tuotteet, .about-kumppanit {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>
