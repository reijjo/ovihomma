---
import Layout from "@/components/layouts/Layout.astro";
import AboutUs from "@/components/pages/about/AboutUs.astro";
import Laatu from "@/components/pages/about/Laatu.astro"
import CtaComponent from "@/components/ui/CtaComponent.astro";
import { t } from "@/i18n"

const i18n = t(Astro.currentLocale);

return Astro.redirect("/", 302);
---

<Layout title={i18n.aboutUs.title} description={i18n.aboutUs.title}>
  <main class="aboutUs-page">
    <h1>{i18n.aboutUs.title}</h1>
    <AboutUs />
    <Laatu />
    <CtaComponent title={i18n.aboutUs.yrityksesta.laatutakuu} />
  </main>
</Layout>

<style>
  .aboutUs-page {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
