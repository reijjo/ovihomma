---
import Layout from "@/components/layouts/Layout.astro";
import { t } from "@/i18n"
import Linkbutton from "@/components/ui/Linkbutton.astro";

const i18n = t(Astro.currentLocale)
---

<Layout title={i18n.huolto.title} description={i18n.huolto.title}>
  <main>
    <div class="wrapper">
      <h1>{i18n.huolto.title}</h1>
      <div class="huolto-wrapper">
        <p set:html={i18n.huolto.eka} />
        <p set:html={i18n.huolto.toka} />
        <p set:html={i18n.huolto.kolmas} />
        <p class="bigger-bolder" set:html={i18n.huolto.vika} />
        <Linkbutton href="/yhteystiedot">{i18n.yleiset.hintatarjous}!</Linkbutton>
      </div>
    </div>
  </main>
</Layout>

<style>
  .huolto-wrapper {
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-wrap: balance;
    text-wrap: pretty;
    max-width: 640px;
    justify-content: center;
    margin: 0 auto;
  }

  .bigger-bolder {
    font-size: 1.125rem;
    font-weight: 600;
		text-wrap: balance;

  }
</style>
