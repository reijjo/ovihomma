      { src: "/images/ovet/rullaovet/thermoteck.webp", alt: "Puerta enrollable Thermoteck" },
      { src: "/images/ovet/rullaovet/thermoteckeasy.webp", alt: "Puerta enrollable Thermoteck Easy" },
