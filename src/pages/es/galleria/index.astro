      { src: "/images/ovet/nosto-ovet/ovella.jpg", alt: "Puerta seccional en un edificio" },
      { src: "/images/ovet/nosto-ovet/silea1.webp", alt: "Puerta seccional lisa" },
      { src: "/images/ovet/nosto-ovet/silea2.webp", alt: "Puerta seccional lisa" },
      { src: "/images/ovet/nosto-ovet/silea3.webp", alt: "Puerta seccional lisa" },
