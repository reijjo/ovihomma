---
import Layout from "@/components/layouts/Layout.astro";
import TuoteIntro from "@/components/pages/tuotteet/TuoteIntro.astro";
import { t } from "@/i18n";

const i18n = t(Astro.currentLocale);
const intro = {
  fi: "Pihaportit ja aidat viimeistelevät kiinteistön ilmeen ja parantavat kulunhallintaa.",
  en: "Yard gates and fences complete the look of a property and improve access control.",
  es: "Las puertas y vallas de jardín completan el aspecto de la propiedad y mejoran el control de acceso.",
}[Astro.currentLocale ?? "fi"];
---

<Layout title={i18n.nav.pihaportitAidat} description={i18n.nav.pihaportitAidat}>
  <main class="tuote-page">
    <TuoteIntro title={i18n.nav.pihaportitAidat} intro={intro ?? ""} />
  </main>
</Layout>
