---
import Layout from "@/components/layouts/Layout.astro";
import TuoteIntro from "@/components/pages/tuotteet/TuoteIntro.astro";
import TuoteKuvia from "@/components/pages/tuotteet/TuoteKuvat.astro";
import CtaComponent from "@/components/ui/CtaComponent.astro";
import { t } from "@/i18n";

const i18n = t(Astro.currentLocale);
---

<Layout title={i18n.nav.pihaportitAidat} description={i18n.nav.pihaportitAidat}>
  <main class="tuote-page semi-empty">
    <TuoteIntro title={i18n.tuotteet.puomit.title} intro={i18n.tuotteet.puomit.info.intro} />
    <TuoteKuvia images={[
      { src: "/images/aidat/piha-aita.jpg", alt: "Piha-aita"},
      { src: "/images/aidat/karu1.jpg", alt: "aita1"},
      { src: "/images/aidat/karu2.jpg", alt: "aita2"}
    ]} />
    <CtaComponent title={i18n.tuotteet.puomit.sell} />
  </main>
</Layout>

<style>
  .tuote-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .semi-empty {
    justify-content: space-between;
    min-height: 100dvh;
    text-align: center;
  }

</style>
