---
import Layout from "@/components/layouts/Layout.astro";
import ContactForm from "@/components/pages/contact/ContactForm.astro";
import { t } from "@/i18n";

const i18n = t(Astro.currentLocale);
---

<Layout title={i18n.contact.title} description={i18n.contact.description}>
  <main class="contact-page">
    <div class="wrapper contact-content">
      <h1>{i18n.contact.title}</h1>
      <ContactForm />
    </div>
  </main>
</Layout>

<style>
  .contact-page {
    padding-bottom: 3rem;
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
