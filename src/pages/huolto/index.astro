---
import Layout from "@/components/layouts/Layout.astro";
import { t } from "@/i18n"
import Linkbutton from "@/components/ui/Linkbutton.astro";

const i18n = t(Astro.currentLocale)
---

<Layout title="Huolto" description="Ovihomma huolto">
  <main>
    <div class="wrapper">
      <h1>{i18n.huolto.title}</h1>
      <div class="huolto-wrapper">
        <p>{i18n.huolto.eka1} <b>{i18n.huolto.ekaBold1}</b>{i18n.huolto.eka2} <b>{i18n.huolto.ekaBold2}</b> {i18n.huolto.eka3} </p>
        <p>{i18n.huolto.toka1} <b>{i18n.huolto.tokaBold1}</b> {i18n.huolto.toka2}</p>
        <p>{i18n.huolto.kolmas1} <b>{i18n.huolto.kolmasBold1}</b>{i18n.huolto.kolmas2}</p>
        <p class="bigger-bolder"><b>{i18n.huolto.vika}</b></p>
        <Linkbutton href="/yhteystiedot">{i18n.yleiset.hintatarjous}!</Linkbutton>
      </div>
    </div>
  </main>
</Layout>

<style>
  .huolto-wrapper {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-wrap: balance;
    text-wrap: pretty;
    max-width: 640px;
    justify-content: center;
    margin: 0 auto;
  }

  .bigger-bolder {
    font-size: 1.125rem;
  }
</style>
