---
import Layout from "@/components/layouts/Layout.astro";
import GalleryPage from "@/components/pages/gallery/GalleryPage.astro";
import CtaComponent from "@/components/ui/CtaComponent.astro";
import { t } from "@/i18n";

const i18n = t(Astro.currentLocale);
const sections = [
  {
    title: i18n.nav.nostoOvet,
    images: [
      { src: "/images/ovet/nosto-ovet/kapea1.webp", alt: "Kapea nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/kapea2.webp", alt: "Kapea nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/kapea3.jpg", alt: "Kapea nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/levea1.webp", alt: "Leveä nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/levea2.webp", alt: "Leveä nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/ovella.jpg", alt: "Nosto-ovi rakennuksessa" },
      { src: "/images/ovet/nosto-ovet/silea1.webp", alt: "Sileä nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/silea2.webp", alt: "Sileä nosto-ovi" },
      { src: "/images/ovet/nosto-ovet/silea3.webp", alt: "Sileä nosto-ovi" },
    ],
  },
  {
    title: i18n.nav.paloOvet,
    images: [
      { src: "/images/ovet/palo-ovet/metalluks6.webp", alt: "Palonkestävä metalliovi" },
      { src: "/images/ovet/palo-ovet/palokaihdin1.webp", alt: "Palonkestävä kaihdin" },
      { src: "/images/ovet/palo-ovet/paloliuku1.webp", alt: "Palonkestävä liukuovi" },
      { src: "/images/ovet/palo-ovet/paloliuku2.webp", alt: "Palonkestävä liukuovi" },
      { src: "/images/ovet/palo-ovet/paloliuku3.webp", alt: "Palonkestävä liukuovi" },
      { src: "/images/ovet/palo-ovet/paloliuku4.webp", alt: "Palonkestävä liukuovi" },
      { src: "/images/ovet/palo-ovet/palometalli1.webp", alt: "Palonkestävä metalliovi" },
      { src: "/images/ovet/palo-ovet/palometalli2.webp", alt: "Palonkestävä metalliovi" },
      { src: "/images/ovet/palo-ovet/palometalli3.webp", alt: "Palonkestävä metalliovi" },
      { src: "/images/ovet/palo-ovet/palorulla1.webp", alt: "Palonkestävä rullaovi" },
      { src: "/images/ovet/palo-ovet/palorulla2.webp", alt: "Palonkestävä rullaovi" },
    ],
  },
  {
    title: i18n.nav.rullaovetTurvakaihtimet,
    images: [
      { src: "/images/ovet/rullaovet/kalterit.webp", alt: "Turvakalterit" },
      { src: "/images/ovet/rullaovet/pikarulla.webp", alt: "Pikarullaovi" },
      { src: "/images/ovet/rullaovet/pvc.webp", alt: "PVC-rullaovi" },
      { src: "/images/ovet/rullaovet/thermoteck.webp", alt: "Thermoteck-rullaovi" },
      { src: "/images/ovet/rullaovet/thermoteckeasy.webp", alt: "Thermoteck Easy -rullaovi" },
      { src: "/images/ovet/rullaovet/xxl.webp", alt: "XXL-rullaovi" },
    ],
  },
  {
    title: i18n.nav.pihaportitAidat,
    images: [
      { src: "/images/aidat/piha-aita.jpg", alt: "Piha-aita1"},
      { src: "/images/aidat/karu1.jpg", alt: "aita1"},
      { src: "/images/aidat/karu3.jpg", alt: "aita3"},
      { src: "/images/aidat/karu2.jpg", alt: "aita2"}
    ],
  },
  {
    title: i18n.nav.kaapit,
    images: [
      { src: "/images/hyllyt/hylly1.jpg", alt: "Hylly 1"},
      { src: "/images/hyllyt/hylly2.jpg", alt: "Hylly 2"},
      { src: "/images/hyllyt/hylly3.jpg", alt: "Hylly 3"},
      { src: "/images/hyllyt/hylly4.jpg", alt: "Hylly 4"},
    ],
  },
];
---

<Layout title={i18n.gallery.title} description={i18n.gallery.description}>
  <GalleryPage
    title={i18n.gallery.title}
    sections={sections}
    labels={i18n.gallery}
  />
  <CtaComponent title={i18n.gallery.sell} />
</Layout>
